{
  "name": "@nexusdesk/api",
  "version": "0.1.0",
  "private": true,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "start": "tsx src/index.ts",
    "lint": "eslint src --ext .ts",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "test": "vitest run",
    "clean": "rimraf dist *.tsbuildinfo"
  },
  "dependencies": {
    "@fastify/cors": "^10.0.2",
    "@fastify/helmet": "^13.0.1",
    "@fastify/rate-limit": "^10.2.2",
    "@nexusdesk/config": "workspace:*",
    "@nexusdesk/crypto": "workspace:*",
    "@nexusdesk/protocol": "workspace:*",
    "@nexusdesk/types": "workspace:*",
    "@nexusdesk/validation": "workspace:*",
    "@prisma/client": "^6.4.1",
    "fastify": "^5.2.1",
    "ioredis": "^5.6.0",
    "jsonwebtoken": "^9.0.2",
    "pino": "^9.6.0",
    "tsx": "^4.19.3",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/jsonwebtoken": "^9.0.9",
    "@types/node": "^22.13.5",
    "prisma": "^6.4.1",
    "rimraf": "^6.0.1",
    "typescript": "^5.7.3",
    "vitest": "^3.0.7"
  }
}

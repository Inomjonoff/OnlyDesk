# NexusDesk AI Local Development Configuration

# Service Ports
API_PORT=4000
SIGNALING_PORT=4001
AI_PORT=4002
WORKER_PORT=4003
WEB_PORT=3000
ADMIN_PORT=3001

# Databases & Cache
DATABASE_URL=postgresql://nexus:nexuspassword@localhost:5432/nexusdesk?schema=public
REDIS_URL=redis://localhost:6379

# JWT & Authentication
JWT_SECRET=dev-jwt-signing-secret-key-at-least-32-characters-long
JWT_REFRESH_SECRET=dev-jwt-refresh-secret-key-at-least-32-characters-long
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# STUN / TURN Server
TURN_HOST=127.0.0.1
TURN_PORT=3478
TURN_USERNAME=nexusdesk
TURN_PASSWORD=nexussecretpassword
STUN_SERVER_URL=stun:stun.l.google.com:19302

# S3 / MinIO Object Storage
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=nexusdesk-recordings
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_USE_SSL=false

# AI Providers
AI_PROVIDER_DEFAULT=google
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_AI_API_KEY=
OPENROUTER_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434

# Observability
LOG_LEVEL=debug
PROMETHEUS_PORT=9090
GRAFANA_PORT=3005
